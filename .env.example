# DeepSeek API Key（默认文本交互模型）
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# 文本业务在 model-registry 中固定使用 DeepSeek-V4-Flash-0731。
# 官方 API id 为 deepseek-v4-flash，不再接受环境变量覆盖。

# Gemini API Key（图片生成、意图识别和 Google Search grounding 仍使用）
# 获取地址: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# 阿里云百炼 API Key (Z-Image 显式选择时使用)
# 获取地址: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# GPT Image 2 图片生成主通道（OpenAI-compatible）
# 主链路只走此通道；失败直接返回错误，不切换到 Krill/Tuzi fallback。
OPENAI_IMAGE_API_KEY=your-openai-compatible-image-api-key
OPENAI_IMAGE_API_BASE_URL=https://api.chaojitudou.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2

# 灵感页以图搜图解析。Chaojitudou 的模型目录可能不展示 gpt-5.6，
# 但兼容接口支持直接调用；失败时仍会降级到 Gemini / Tuzi。
# DISCOVERY_IMAGE_ANALYSIS_PROVIDER=chaojitudou
# DISCOVERY_IMAGE_ANALYSIS_CHAOJITUDOU_MODEL=gpt-5.6
# 如图片生成与图片解析使用不同账号，可单独配置以下两项：
# DISCOVERY_IMAGE_ANALYSIS_CHAOJITUDOU_API_KEY=your-chaojitudou-api-key
# DISCOVERY_IMAGE_ANALYSIS_CHAOJITUDOU_BASE_URL=https://api.chaojitudou.com/v1

# Tuzi 图片生成通道（仅供显式选择其他模型时使用，不作为 GPT Image 2 fallback）
TUZI_API_KEY=your-tuzi-default-group-api-key
TUZI_IMAGE_API_BASE_URL=https://apius.tu-zi.com
TUZI_ENABLE_OPENAI_COMPAT_FALLBACK=false
TUZI_API_BASE_URL=https://api.tu-zi.com
# 可选：Docker MCP Toolkit / NewAPI 导出的统一连接 JSON。不要提交真实 key。
# TUZI_CHANNEL_CONNECTION={"_type":"newapi_channel_conn","key":"your-key","url":"https://api.tu-zi.com"}
# Moodboard 多模态分析可显式走 Tuzi；未指定时优先 Gemini，失败后自动尝试 Tuzi。
# MOODBOARD_ANALYSIS_PROVIDER=tuzi
# MOODBOARD_ANALYSIS_TUZI_MODEL=gpt-5.5
# 可选：逗号分隔禁用通道，可选值 default,official_discount,official
TUZI_DISABLED_IMAGE_CHANNELS=
# provider_policy 跨 provider 回退的每日预算上限（方案 B；0 表示关闭回退）
IMAGE_POLICY_FALLBACK_DAILY_LIMIT=100
# 可选：供应商调整模型 ID 时可按内部模型覆盖实际 api model
TUZI_IMAGE_API_MODEL_GPT_IMAGE_2=gpt-image-2
TUZI_IMAGE_API_MODEL_NANO_BANANA_2=gemini-3.1-flash-image-preview
TUZI_IMAGE_API_MODEL_NANO_BANANA_PRO=gemini-3-pro-image-preview
TUZI_IMAGE_API_MODEL_MIDJOURNEY_V7=midjourney-v7
TUZI_IMAGE_API_MODEL_MIDJOURNEY_NIJI_V7=midjourney-niji-v7
TUZI_IMAGE_API_MODEL_SEEDREAM_5_PRO=seedream-5-0-pro
TUZI_IMAGE_API_MODEL_SEEDREAM_5_LITE=seedream-5-0-lite
TUZI_IMAGE_API_MODEL_WAN_IMAGE_2_7_PRO=wan-image-2.7-pro

# Tuzi 视频生成预留模型目录（默认关闭；只在显式测试开关打开时发起供应商调用）
TUZI_VIDEO_GENERATION_ENABLED=false
# 正式上线开关：渠道未验通前保持 false；Tuzi Seedance 修复后再打开。
TUZI_VIDEO_LAUNCH_ENABLED=false
TUZI_VIDEO_ALLOW_UNBILLED_TEST_CALLS=false
# Seedance 毛利守护参数。默认值来自生产成功任务与火山引擎公开单价；
# 对账后的供应商账单数据可通过这些变量覆盖。
VIDEO_COGS_TOKENS_PER_SECOND=10500
VIDEO_COGS_CNY_PER_USD=7
VIDEO_COGS_OPERATIONAL_OVERHEAD_RATE=0.1
# Seedance 2.5 官方 2026-07-30 公布价：不含视频输入 70 元/百万 token，含视频输入 42 元/百万 token。
VIDEO_COGS_SEEDANCE_2_5_CNY_PER_MILLION_TOKENS=70
VIDEO_COGS_SEEDANCE_2_0_CNY_PER_MILLION_TOKENS=46
VIDEO_COGS_SEEDANCE_2_0_FAST_CNY_PER_MILLION_TOKENS=37
VIDEO_COGS_SEEDANCE_2_0_MINI_CNY_PER_MILLION_TOKENS=23
TUZI_VIDEO_API_BASE_URL=https://api.tu-zi.com
TUZI_VIDEO_CREATE_PATH=/v1/videos
TUZI_VIDEO_STATUS_PATH_TEMPLATE=/v1/videos/{id}
TUZI_VIDEO_REQUEST_MODE=openai-videos
TUZI_VIDEO_API_MODEL_SEEDANCE_2_0=doubao-seedance-2-0

# 可选：仅在火山方舟变更模型版本时覆盖内置的正式 Model ID。
# ARK_VIDEO_API_MODEL_SEEDANCE_2_5=doubao-seedance-2-5-260628

# Tuzi 官方优惠分组兜底（可选，默认禁用；近期 timeout / policy 噪声较高）
TUZI_ENABLE_OFFICIAL_DISCOUNT_FALLBACK=false
TUZI_OFFICIAL_DISCOUNT_API_KEY=your-tuzi-official-discount-group-api-key
TUZI_OFFICIAL_DISCOUNT_API_BASE_URL=https://api.tu-zi.com
TUZI_OFFICIAL_DISCOUNT_IMAGE_MODEL=gpt-image-2

# Tuzi 官方分组高成本最终兜底（可选）
# 仅在 default 分组出现超时/资源不足等可重试失败后使用
TUZI_OFFICIAL_API_KEY=your-tuzi-official-group-api-key
TUZI_OFFICIAL_API_BASE_URL=https://api.tu-zi.com
TUZI_OFFICIAL_IMAGE_MODEL=gpt-image-2

# Cloudflare Workers API 代理 URL（可选）
# 如果部署了 Cloudflare Workers，可以通过代理访问 API
VITE_API_PROXY_URL=https://your-worker.workers.dev

# Cloudflare Workers 代理认证密钥（可选）
# 与 Worker 端的 PROXY_API_KEY 保持一致
VITE_PROXY_API_KEY=your-proxy-api-key-here

# Kitesurf 渲染冒烟（可选）
# 部署后调用 webtomind Worker 的 /__smoke/kitesurf 验证 JS 渲染的关键页面。
# 路由鉴权复用 CRON_SECRET；如需独立密钥，设置 KITESURF_SMOKE_TOKEN。
# 设置 KITESURF_SMOKE_REST_TOKEN（需 Browser Rendering - Edit 权限）可让脚本
# 直接走 REST 端点 ?browser=kitesurf；更推荐用 cf:credentials:set -- browser-run 写入
# 凭据库（见 docs/KITESURF_SMOKE.md）。未配置时 Kitesurf 验证走官方 playground CDP。
KITESURF_SMOKE_BASE_URL=https://webtomind.com
KITESURF_SMOKE_TOKEN=
KITESURF_SMOKE_REST_TOKEN=

# Supabase 配置（用于 Web 端认证）
# 获取地址: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# watermarks-remover service（AI 标记清理工具；仅服务端 / Cloudflare Worker）
# 本地运行 `pnpm watermarks:setup && pnpm watermarks:up` 自动生成并同步密钥。
# 生产环境由部署脚本注入同一份 WATERMARKS_SERVER_API_KEY / WATERMARKS_SERVICE_API_KEY。
WATERMARKS_SERVICE_URL=http://127.0.0.1:8765
WATERMARKS_SERVICE_API_KEY=

# Google Identity Services Client ID（用于全站 Google 账号快捷登录提示）
# 获取地址: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# 应用基础 URL（可选，默认 https://webtomind.com）
VITE_APP_BASE_URL=https://webtomind.com

# ZPAY 支付宝（仅服务端 / Cloudflare Worker，真实 KEY 必须用 secret 注入）
ZPAY_CHECKOUT_ENABLED=false
ZPAY_PID=your-zpay-merchant-id
ZPAY_KEY=your-zpay-merchant-key
# 固定结算汇率：数据库套餐价为美元分，ZPAY 收款为人民币元。
ZPAY_USD_TO_CNY_RATE=
ZPAY_SUBMIT_URL=https://zpayz.cn/submit.php

# SEO Trend Radar（可选，用于每日扫描 X 带链接爆款推文并产出新词候选）
# AISA 用于 X advanced search；域名年龄使用免费 RDAP；流量默认使用免费热度代理。
AISA_API_KEY=
AISA_API_BASE_URL=https://api.aisa.one/apis/v1
# 可选：如果已有 AITDK，可继续用于预估访问量；未配置时不会影响日报生成。
# AITDK_API_KEY=
# AITDK_API_BASE_URL=https://api.aitdk.com

# GA4 Data API（用于运营/SEO/转化分析脚本，不进入前端 bundle）
# 推荐创建 Google Cloud service account，并在 GA4 property 里授予 Viewer 权限。
GA4_PROPERTY_ID=524254844
# 方案 A：base64 后的 service account JSON，适合 GitHub Actions / cron secrets
GA4_SERVICE_ACCOUNT_JSON_B64=
# 方案 B：原始 service account JSON，适合本机 .env.local；不要提交真实值
GA4_SERVICE_ACCOUNT_JSON=
# 方案 C：本机 JSON 文件路径；文件不要放进仓库
GOOGLE_APPLICATION_CREDENTIALS=

# Upstash Redis（可选，用于分布式 API 限流）
# 获取地址: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Product Hunt 发布优惠码（年付 5 折；服务端结账校验用）
# 建码脚本: node scripts/create-ph-promo.mjs --mode=test|live（生产码在 Stripe Dashboard 管理）
PH_PROMO_PERCENT_OFF=50

# 日志级别配置（可选）
# 0 = SILENT（静默，不输出任何日志）
# 1 = ERROR（仅错误）
# 2 = WARN（错误和警告，生产环境默认）
# 3 = INFO（错误、警告和信息）
# 4 = DEBUG（所有日志，开发环境默认）
VITE_LOG_LEVEL=4

# 开发环境配置
NODE_ENV=development
