# API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com  # 可选，使用第三方供应商时替换（不要包含 /v1）
ANTHROPIC_MODEL=claude-sonnet-4-20250514      # 可选，第三方 API 可能需要不同的模型名称
GOOGLE_API_KEY=your-google-api-key
# Agent 工具确认配置（逗号分隔）
# 默认: wechat_publish,e2b_execute,summary_delete
# 特殊值: all=全部工具都需确认, none=关闭全部确认
# AGENT_CONFIRMATION_TOOLS=wechat_publish,e2b_execute,summary_delete
# AGENT_CONFIRMATION_DECISION_TTL_MS=300000
# AGENT_CONFIRMATION_STORE_FILE=.runtime/tool-confirmations.json
# AGENT_CONFIRMATION_STORE_BACKEND=auto  # auto|file

# 第三方 Claude API 配置示例（如 tu-zi.com）
# ANTHROPIC_AUTH_TOKEN=your-third-party-token
# ANTHROPIC_BASE_URL=https://api.tu-zi.com
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ==============================================
# Agent 引擎选择
# ==============================================
# legacy: 使用原有 ClaudeAgent/GeminiAgent（默认）
# openagent: 使用 open-agent-sdk 统一引擎
# AGENT_ENGINE=legacy

# Server Config
PORT=3000
NODE_ENV=development

# CORS - 允许的前端域名，多个用逗号分隔
# 生产环境: 设置为你的 Vercel 域名，如 https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001,chrome-extension://<your-extension-id>

# Supabase (必需)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Proxy (如果需要代理访问 API)
# HTTPS_PROXY=http://127.0.0.1:7890

# ==============================================
# Grok API 配置（第三方 API）
# ==============================================
# Grok API 密钥（用于 Twitter/X 搜索）
# GROK_API_KEY=your-grok-api-key
# Grok API Base URL（第三方供应商）
# GROK_BASE_URL=https://api.x.ai
# Grok 模型（可选，默认 grok-3）
# GROK_MODEL=grok-3

# ==============================================
# 主文本模型（工作台 Agent / OpenAgent 引擎，OpenAI 兼容协议）
# ==============================================
# DeepSeek-V4-Flash-0731 通过 OpenAI-compatible endpoint 调用
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.deepseek.com
# 模型在代码中固定为官方 API id deepseek-v4-flash，不再通过 OPENAI_MODEL 覆盖。

# ==============================================
# VLM（视觉模型，独立配置，避免主文本模型切到不支持视觉的 provider 时图像理解失效）
# 用于：Agent 看图（vision-preprocessor）+ 个人素材上传反推（prompt-asset-reverse）
# 如不配置，会回退到主 OPENAI_* 一组 env
# ==============================================
# OPENAI_VLM_API_KEY=your-vlm-api-key
# OPENAI_VLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OPENAI_VLM_MODEL=glm-4.6v

# ==============================================
# E2B 脚本执行配置
# ==============================================
# E2B API 密钥（用于云端脚本执行）
# 注册地址: https://e2b.dev
# E2B_API_KEY=your-e2b-api-key
