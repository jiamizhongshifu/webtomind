{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "siskill",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-17",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "siskill.dev", "custom_domain": true },
    { "pattern": "www.siskill.dev", "custom_domain": true }
  ]
}
