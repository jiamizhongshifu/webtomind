{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "siskill",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-17",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "SISKILL_COMMERCE_ENABLED": "false",
    "SISKILL_MEMBERSHIP_ENABLED": "false",
    "SISKILL_AUTH_REDIRECTS_READY": "true"
  },
  "r2_buckets": [
    { "binding": "SISKILL_PACKAGES", "bucket_name": "siskill-paid-packages" },
    {
      "binding": "SISKILL_FREE_PACKAGES",
      "bucket_name": "siskill-free-packages"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "siskill.dev", "custom_domain": true },
    { "pattern": "www.siskill.dev", "custom_domain": true }
  ]
}
