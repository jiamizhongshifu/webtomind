{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://webtomind.com",
          "https://www.webtomind.com"
        ],
        "methods": [
          "GET",
          "HEAD"
        ],
        "headers": [
          "*"
        ]
      },
      "exposeHeaders": [
        "Accept-Ranges",
        "Cache-Control",
        "Content-Length",
        "Content-Range",
        "Content-Type",
        "ETag",
        "Last-Modified"
      ],
      "maxAgeSeconds": 86400
    }
  ]
}
